# Copy to apps/bot/.env and fill in your secrets (.env is gitignored).
# Part-1 (core) variables only. MCP and app-server vars return with their phases.

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
NODE_ENV="development"

# ----------------------------------------------------------------------------
# Slack — create the app from slack-manifest.json
# ----------------------------------------------------------------------------
# App-level token for Socket Mode (connections:write). https://api.slack.com/apis/connections/socket
SLACK_APP_TOKEN="xapp-your-app-token"
# Bot User OAuth Token (OAuth & Permissions)
SLACK_BOT_TOKEN="xoxb-your-bot-token"
# Signing Secret (Basic Information)
SLACK_SIGNING_SECRET="your-signing-secret"
# Socket Mode (recommended for local dev)
SLACK_SOCKET_MODE=true
# HTTP port when Socket Mode is disabled
PORT=3000
# Optional gating
# OPT_IN_CHANNEL="C12345678"
# AUTO_ADD_CHANNEL="C12345678"

# ----------------------------------------------------------------------------
# Database (PostgreSQL) — staging. Used by db:push.
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:6543/postgres"

# ----------------------------------------------------------------------------
# Model providers. Attempts run HackClub → the owner's own Gemini key.
# ----------------------------------------------------------------------------
HACKCLUB_API_KEY="sk-hc-your-hackclub-api-key"
# INFERENCE_API_KEY="your-inference-api-key"
EXA_API_KEY="your-exa-api-key"

# Passphrase that encrypts users' OWN model keys (BYOK) at rest — it is stretched
# with scrypt into an AES-256-GCM key, so give it real entropy (min 32 chars):
#   openssl rand -base64 48
# Unset = BYOK is off entirely (no App Home section, no per-user routing) rather
# than storing user keys in the clear. Changing it makes every stored key
# unreadable, and users must re-add them. This same key also gates "Sign in with
# ChatGPT" (OAuth tokens are stored with the same encryption).
# BYOK_ENCRYPTION_KEY="generate-me"

# Optional override for the "Sign in with ChatGPT" OAuth client id. Defaults to
# OpenAI's public Codex CLI client; only set this if OpenAI rotates it.
# CHATGPT_OAUTH_CLIENT_ID="app_EMoamEEZ73f0CkXaXp7hrann"

# ----------------------------------------------------------------------------
# Optional sandbox-side services
# ----------------------------------------------------------------------------
# AGENTMAIL_API_KEY="your-agentmail-api-key"

# ----------------------------------------------------------------------------
# Code Sandbox (E2B). https://e2b.dev/
# ----------------------------------------------------------------------------
E2B_API_KEY="your-e2b-api-key"

# ----------------------------------------------------------------------------
# Observability (Langfuse) — optional
# ----------------------------------------------------------------------------
# LANGFUSE_SECRET_KEY="sk-lf-..."
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_BASEURL="https://cloud.langfuse.com"

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_DIRECTORY="logs"
LOG_LEVEL="info"

# ----------------------------------------------------------------------------
# Owner dashboard (lib/dashboard) — served at https://<SITES_PUBLIC_HOST>/_dashboard
# ----------------------------------------------------------------------------
# Review desk for memory promotion and GitHub write trust. Both are privilege
# grants, so this password is the only thing guarding them: use a long random
# one. Leave unset to disable the dashboard entirely (the route 404s).
DASHBOARD_PASSWORD=""
